<style>
:root{
  --ink:#3b2e2a;--muted:#8a7a72;--surface:#fdf7f0;--accent:#d8616e;--line:#e8ded5;
  --sans:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
  --serif:"Iowan Old Style","Palatino Linotype",Palatino,Georgia,serif;
}
*{box-sizing:border-box}
html,body{margin:0;padding:0;background:var(--surface);color:var(--ink);font-family:var(--sans)}
a{color:var(--accent);text-decoration:none}a:hover{text-decoration:underline}
.wrap{max-width:760px;margin:0 auto;padding:72px 20px 40px}
.brand{display:block;text-align:center;margin-bottom:26px}
.brand img{height:46px;width:auto;object-fit:contain}
h1{font-family:var(--serif);font-weight:800;font-size:1.7rem;margin:0 0 4px;text-align:center}
.sub{color:var(--muted);font-size:.9rem;text-align:center;margin:0 0 26px}
.card{background:#fff;border:1px solid var(--line);border-radius:14px;padding:18px 18px 14px;margin:0 0 16px;box-shadow:0 8px 18px rgba(140,90,70,.07)}
.row{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
button{font:700 .82rem var(--sans);border-radius:999px;border:1px solid var(--line);background:#fff;color:var(--ink);padding:9px 16px;cursor:pointer}
button:hover{border-color:var(--accent);color:var(--accent)}
button.big{background:var(--accent);color:#fff;border-color:var(--accent);padding:11px 22px;font-size:.95rem}
button.big:hover{opacity:.88}
button.on{background:#b43f4f;border-color:#b43f4f;color:#fff}
select,input[type=text]{font:600 .82rem var(--sans);border:1px solid var(--line);border-radius:999px;padding:9px 14px;background:#fff;color:var(--ink)}
input[type=text]{border-radius:10px;flex:1;min-width:170px}
.tag{display:inline-block;background:#f3e7e0;color:var(--accent);border-radius:8px;font-weight:700;font-size:.75rem;padding:3px 9px}
audio{width:100%;margin-top:10px}
table{width:100%;border-collapse:collapse;margin-top:10px;font-size:.85rem;table-layout:fixed;word-wrap:break-word;overflow-wrap:break-word}
th,td{border-bottom:1px solid var(--line);padding:8px 6px;text-align:left;vertical-align:middle}
th{color:var(--muted);font-weight:700;font-size:.72rem;text-transform:uppercase;letter-spacing:.04em}
.ok{color:#4a8a55;font-weight:700}.no{color:#b43f4f;font-weight:700}
.note{color:var(--muted);font-size:.8rem;margin:6px 0 0}
.footer{text-align:center;color:var(--muted);font-size:.78rem;margin-top:22px}
html[lang="en"] .lang-vi{display:none}
html:not([lang="en"]) .lang-en{display:none}
html[lang="fr"] .lang-vi{display:none}
html[lang="fr"] .lang-en{display:none}
html:not([lang="fr"]) .lang-fr{display:none}
.langtog{position:fixed;top:14px;right:14px;z-index:6;display:inline-flex;border:1px solid var(--line);border-radius:20px;overflow:hidden;background:#fff;box-shadow:0 6px 14px rgba(140,90,70,.1)}
.langtog button{border:none;background:transparent;color:var(--muted);font:700 .72rem var(--sans);padding:6px 11px}
.langtog button.active{background:var(--accent);color:#fff}
@media(max-width:560px){h1{font-size:1.35rem}.wrap{padding-top:66px}.row{gap:6px}}
.skip-link{position:absolute;top:-52px;left:12px;background:#a8394e;color:#fff;font:700 .85rem sans-serif;padding:10px 16px;z-index:100;border-radius:0 0 10px 10px;text-decoration:none;transition:top .2s}.skip-link:focus{top:0;outline:3px solid #a8394e;outline-offset:2px}</style>
<style>
/* ===== DeepMind-style header ===== */
.dmnav{position:fixed;top:0;left:0;right:0;z-index:60;display:flex;align-items:center;gap:10px;padding:10px 16px;
  background:color-mix(in srgb,var(--surface) 78%,transparent);backdrop-filter:blur(14px);
  -webkit-backdrop-filter:blur(14px);transition:padding .25s ease,box-shadow .25s ease}
.dmnav.shrink{padding:6px 16px;box-shadow:0 2px 12px rgba(60,30,30,.12)}
.dmnav .dmlogo{display:inline-flex;align-items:center;gap:8px;text-decoration:none;color:var(--ink);line-height:0;flex-shrink:0}
.dmnav .dmlogo img{height:30px;width:auto}
.dmnav .dmlabel{font:600 .78rem/1 var(--serif);color:var(--ink);letter-spacing:.02em}
.dmnav .dmlabel small{display:block;font:600 .56rem/1.2 var(--sans);color:var(--muted);letter-spacing:.14em;text-transform:uppercase;margin-top:2px}
.dmnav .dmright{margin-left:auto;display:flex;align-items:center;gap:6px;overflow-x:auto;max-width:calc(100vw - 170px)}
.dmnav .dmright a{color:var(--ink);text-decoration:none;font:500 .76rem/1.4 var(--sans);padding:6px 8px;white-space:nowrap;
  background-image:linear-gradient(var(--accent),var(--accent));background-size:0% 1.5px;background-repeat:no-repeat;background-position:0 100%;transition:background-size .28s ease,color .2s}
.dmnav .dmright a:hover{color:var(--accent);background-size:100% 1.5px}
.dmnav .dmico{display:inline-flex;width:32px;height:32px;align-items:center;justify-content:center;border-radius:50%;color:var(--muted);font-size:.9rem;text-decoration:none;transition:color .2s,background .2s}
.dmnav .dmico:hover{color:var(--accent);background:var(--accent-soft)}
@media(max-width:760px){.dmnav{padding:7px 10px;gap:6px;flex-wrap:nowrap}.dmnav .dmlabel small{display:none}.dmnav .dmlabel{font-size:.7rem}
.dmnav .dmright{max-width:calc(100vw - 150px);flex-wrap:nowrap;overflow-x:auto;scrollbar-width:none;-ms-overflow-style:none}
.dmnav .dmright::-webkit-scrollbar{display:none}
.dmnav .dmright a{font-size:.66rem;padding:5px 5px;white-space:nowrap;flex-shrink:0}
.dmnav .dmico{width:28px;height:28px;font-size:.8rem;flex-shrink:0}.dmnav .dmico:last-child{display:none}.dmnav .dmright{min-width:0}.dmnav{max-width:100%;overflow-x:auto;scrollbar-width:none;-ms-overflow-style:none;flex-shrink:1}.dmnav::-webkit-scrollbar{display:none}
.dmnav .hide-xs{display:none}}
/* ===== DeepMind-style footer ===== */
.dmfooter{background:linear-gradient(160deg,#26211f,#2e2724);color:#d8cdc7;padding:52px 24px 26px;margin-top:64px;border-radius:20px 20px 0 0}
.dmfooter .dmf-grid{display:grid;grid-template-columns:1.6fr 1fr 1fr 1fr;gap:28px;max-width:1100px;margin:0 auto}
.dmfooter h4{font:700 .78rem/1 var(--sans);letter-spacing:.16em;text-transform:uppercase;color:#efe6e2;margin:0 0 14px}
.dmfooter p{font:.85rem/1.6 var(--sans);color:#b9aca5;margin:0}
.dmfooter .dmf-tag{font:600 clamp(1.3rem,3.2vw,1.9rem)/1.25 var(--serif);color:#efe6e2;max-width:100%;margin:10px 0 6px}
.dmfooter a{color:#b9aca5;text-decoration:none;font:.82rem/1.9 var(--sans);display:block}
.dmfooter a:hover{color:#fff;text-decoration:underline}
.dmfooter .dmf-ico{display:inline-flex;gap:8px;margin:16px 0 0}
.dmfooter .dmf-ico a{display:inline-flex;width:34px;height:34px;align-items:center;justify-content:center;border:1px solid #4a413c;border-radius:50%;font-size:.85rem}
.dmfooter .dmf-ico a:hover{background:#4a413c;text-decoration:none}
.dmfooter .dmf-bottom{border-top:1px solid #40383320;margin-top:36px;padding-top:18px;display:flex;flex-wrap:wrap;gap:8px 24px;font:.76rem/1.6 var(--sans);color:#8f817a;max-width:1100px;margin-left:auto;margin-right:auto}
.dmfooter .dmf-bottom span{white-space:nowrap}
@media(max-width:820px){.dmfooter .dmf-grid{grid-template-columns:1fr 1fr;gap:22px 28px}}
@media(max-width:480px){.dmfooter .dmf-grid{grid-template-columns:1fr}}
/* ===== Hiệu ứng động ===== */
@media(prefers-reduced-motion:no-preference){
  .reveal{opacity:0;transform:translateY(22px);transition:opacity .6s ease,transform .6s ease}
  .reveal.on{opacity:1;transform:none}
  .reveal.d1{transition-delay:.08s}.reveal.d2{transition-delay:.16s}.reveal.d3{transition-delay:.24s}.reveal.d4{transition-delay:.32s}
  #bando{transition:transform .1s linear}
}
</style>  <link rel="canonical" href="https://thuyhuongctu.github.io/JESUISHUONG_WEBSITE_2026/audio.html">
</head>
<body>
