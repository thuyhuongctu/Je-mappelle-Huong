<div class="langtog"><button type="button" data-lang="vi" class="active">🇻🇳 VI</button><button type="button" data-lang="en">🇬🇧 EN</button><button type="button" data-lang="fr">🇫🇷 FR</button><button class="toprefresh" id="nut-ref" type="button" style="border:1px solid rgba(140,90,70,.3);border-radius:20px;background:#fff;box-shadow:0 6px 14px rgba(140,90,70,.1);font-size:.8rem;padding:5px 11px;cursor:pointer;color:#3a2f2a;font:700 .74rem system-ui;margin-right:8px"><span>⟳</span> <span id="nut-ref-t">Làm mới</span></button></div>
<div class="wrap" id="main">
  <a class="brand" href="index.html"><img src="assets/img/lr-je-mappelle-huong.webp" alt="Je m'appelle Hương · Lecturer &amp; Researcher"></a>
  <h1><span class="lang-vi">🎙️ Phòng thu lời dẫn tour</span><span class="lang-en">🎙️ Tour Narration Studio</span><span class="lang-fr">🎙️ Studio de narration</span></h1>
  <p class="sub"><span class="lang-vi">Ghi âm bằng micro hoặc tải file audio, đặt tên đúng quy ước, nghe lại và tải về</span><span class="lang-en">Record via microphone or upload audio, name it correctly, preview and download</span><span class="lang-fr">Enregistrez au micro ou téléchargez un fichier, nommez-le correctement, écoutez et téléchargez</span></p>

  <div class="card">
    <div class="row" style="justify-content:space-between">
      <div>
        <label class="tag"><span class="lang-vi">Khu</span><span class="lang-en">Area</span><span class="lang-fr">Étape</span></label>
        <select id="khu">
          <option value="chao">chao</option>
          <option value="about">about</option>
          <option value="inspiration">inspiration</option>
          <option value="ecosystem">ecosystem</option>
          <option value="gallery">gallery</option>
          <option value="pubs">pubs</option>
          <option value="teaching">teaching</option>
          <option value="worlddata">worlddata</option>
        </select>
        <select id="nn">
          <option value="vi">🇻🇳 vi</option><option value="en">🇬🇧 en</option><option value="fr">🇫🇷 fr</option>
        </select>
      </div>
      <span class="tag" id="tenGoiY">chao_vi.mp3</span>
    </div>
  </div>

  <div class="card">
    <div class="row" style="gap:10px">
      <button type="button" class="big" id="btnThu">🎤 <span class="lang-vi">Bắt đầu ghi âm</span><span class="lang-en">Start recording</span><span class="lang-fr">Démarrer l’enregistrement</span></button>
      <button type="button" id="btnDung" disabled>⏹ <span class="lang-vi">Dừng</span><span class="lang-en">Stop</span><span class="lang-fr">Arrêter</span></button>
      <label style="font:700 .82rem var(--sans)">📁 <input type="file" id="fileUp" accept="audio/*" style="display:none"><button type="button" id="btnTai">⬆️ <span class="lang-vi">Tải file lên</span><span class="lang-en">Upload file</span><span class="lang-fr">Téléverser</span></button></label>
    </div>
    <p class="note"><span class="lang-vi">⚠️ Trình duyệt web không thể tự ghi thẳng vào website — bản ghi sẽ được lưu trong trang để bạn nghe lại và tải về, rồi đưa file vào thư mục <code>assets/audio/tour/</code> của repo.</span><span class="lang-en">⚠️ A static website cannot save files by itself — recordings stay in the page for preview and download, then add the files to the <code>assets/audio/tour/</code> folder of the repo.</span><span class="lang-fr">⚠️ Un site statique ne peut pas enregistrer de fichier — les enregistrements restent dans la page pour écoute et téléchargement, puis ajoutez-les au dossier <code>assets/audio/tour/</code> du dépôt.</span></p>
    <audio id="ngheLai" controls style="display:none"></audio>
    <div class="row" id="hangTve" style="display:none;margin-top:10px">
      <button type="button" id="btnTve">⬇️ <span class="lang-vi">Tải về đúng tên</span><span class="lang-en">Download with correct name</span><span class="lang-fr">Télécharger sous le bon nom</span></button>
      <span class="tag" id="tenVe">—</span>
    </div>
  </div>

  <div class="card">
    <h3 style="margin:0 0 8px;font-family:var(--serif)"><span class="lang-vi">📋 Danh sách lời dẫn (kiểm tra trước khi đưa lên repo)</span><span class="lang-en">📋 Narration checklist (verify before adding to the repo)</span><span class="lang-fr">📋 Liste des narrations (vérifiez avant d’ajouter au dépôt)</span></h3>
    <table id="bang"></table>
    <p class="note"><span class="lang-vi">Đuôi .mp3 là tiêu chuẩn web; nếu file gốc là .wav/.m4a, đổi đuôi khi tải về cũng được.</span><span class="lang-en">.mp3 is the web standard; renaming .wav/.m4a on download also works.</span><span class="lang-fr">.mp3 est le standard web ; renommer .wav/.m4a au téléchargement fonctionne aussi.</span></p>
  </div>

  <div class="footer">Je m'appelle Hương · Lecturer &amp; Researcher · <a href="index.html"><span class="lang-vi">Về trang chủ</span><span class="lang-en">Back to home</span><span class="lang-fr">Retour à l’accueil</span></a></div>
</div>

<script>(function(){
  var khuSel=document.getElementById('khu'), nnSel=document.getElementById('nn'),
      tenGoiY=document.getElementById('tenGoiY'), hangTve=document.getElementById('hangTve'),
      tenVe=document.getElementById('tenVe'), ngLai=document.getElementById('ngheLai');
  var KHU=['chao','about','inspiration','ecosystem','gallery','pubs','teaching','worlddata'];
  var NN={vi:{kh:'Khu',nn:'Ngôn ngữ'},en:{kh:'Area',nn:'Language'},fr:{kh:'Étape',nn:'Langue'}};
  function tenFile(){ return khuSel.value + '_' + nnSel.value + '.mp3'; }
  function capNhatTen(){ tenGoiY.textContent = tenFile(); }
  khuSel.addEventListener('change', capNhatTen); nnSel.addEventListener('change', capNhatTen); capNhatTen();

  // Ghi âm
  var thu=null, chunks=[], btnThu=document.getElementById('btnThu'), btnDung=document.getElementById('btnDung'), btnTai=document.getElementById('btnTai');
  var blobHien=null;
  function datBai(blob){
    blobHien=blob;
    ngLai.src = URL.createObjectURL(blob);
    ngLai.style.display='block';
    hangTve.style.display='flex';
    tenVe.textContent = tenFile();
  }
  btnTai.addEventListener('click', function(){ document.getElementById('fileUp').click(); });
  document.getElementById('fileUp').addEventListener('change', function(e){
    var f=e.target.files[0]; if(!f) return;
    // tự đoán khu_nn từ tên file
    var m=f.name.toLowerCase().match(/^(chao|about|inspiration|ecosystem|gallery|pubs|teaching|worlddata)_(vi|en|fr)/);
    if(m){ khuSel.value=m[1]; nnSel.value=m[2]; capNhatTen(); }
    datBai(f);
  });
  btnThu.addEventListener('click', async function(){
    try{
      var stream = await navigator.mediaDevices.getUserMedia({audio:true});
      thu = new MediaRecorder(stream, {mimeType: MediaRecorder.isTypeSupported('audio/webm;codecs=opus') ? 'audio/webm;codecs=opus' : 'audio/webm'});
      chunks=[];
      thu.ondataavailable = function(e){ if(e.data.size) chunks.push(e.data); };
      thu.onstop = function(){
        stream.getTracks().forEach(function(t){ t.stop(); });
        datBai(new Blob(chunks, {type:'audio/webm'}));
      };
      thu.start();
      btnThu.classList.add('on'); btnThu.disabled=true; btnDung.disabled=false;
    }catch(err){
      alert(lang()=== 'vi' ? 'Không truy cập được micro. Hãy cấp quyền micro cho trang.' : lang()==='fr' ? 'Micro indisponible. Autorisez l’accès au micro.' : 'Microphone not available. Please allow microphone access.');
    }
  });
  btnDung.addEventListener('click', function(){ if(thu && thu.state!=='inactive') thu.stop(); thu=null; btnThu.classList.remove('on'); btnThu.disabled=false; btnDung.disabled=true; });
  document.getElementById('btnTve').addEventListener('click', function(){
    if(!blobHien) return;
    var a=document.createElement('a');
    a.href = URL.createObjectURL(blobHien);
    a.download = tenFile();
    document.body.appendChild(a); a.click(); document.body.removeChild(a);
  });

  // Bảng kiểm tra
  function bang(){
    var L = lang(); var t = NN[L] || NN.vi;
    var html='<tr><th>File</th><th>'+t.kh+'</th><th>'+t.nn+'</th><th>Status</th></tr>';
    KHU.forEach(function(k){ ['vi','en','fr'].forEach(function(n){
      var f=k+'_'+n+'.mp3';
      html+='<tr><td><b>'+f+'</b></td><td>'+khuNhan(k,L)+'</td><td>'+n.toUpperCase()+'</td><td class="no">—</td></tr>';
    }); });
    document.getElementById('bang').innerHTML = html;
  }
  function khuNhan(k,L){ var map={chao:'Greeting',about:'About',inspiration:'Inspiration',ecosystem:'Ecosystem',gallery:'Gallery',pubs:'Publications',teaching:'Teaching',worlddata:'World data'}; return map[k]||k; }

  // Ngôn ngữ (cơ chế đồng bộ với trang chủ)
  function lang(){ var l=document.documentElement.lang; return (l==='en'||l==='fr') ? l : 'vi'; }
  var bt=document.querySelectorAll('.langtog button[data-lang]');
  function set(l){ document.documentElement.setAttribute('lang',l); bt.forEach(function(x){ x.classList.toggle('active', x.getAttribute('data-lang')===l); }); try{localStorage.setItem('huong_lang',l);}catch(e){} bang(); }
  bt.forEach(function(x){ x.addEventListener('click', function(){ set(x.getAttribute('data-lang')); }); });
  var s='vi'; try{ s = localStorage.getItem('huong_lang') || (/^en/i.test(navigator.language) ? 'en' : (/^fr/i.test(navigator.language) ? 'fr' : 'vi')); }catch(e){}
  set(s); bang();
})();</script>

<script>
/* Nút làm mới trang + tự phát hiện bản cập nhật PWA */
(function(){
  function doReload(){
    if('serviceWorker' in navigator && navigator.serviceWorker.controller){
      navigator.serviceWorker.getRegistrations().then(function(rs){
        rs.forEach(function(r){r.unregister();});
      }).catch(function(){});
    }
    // xóa cache tĩnh của app trước khi reload
    if('caches' in window){
      caches.keys().then(function(ks){ks.forEach(function(k){caches.delete(k);});});
    }
    setTimeout(function(){location.reload();},150);
  }
  var b=document.getElementById('nut-ref');
  if(b){b.addEventListener('click',doReload);}
  /* tự gợi ý làm mới khi có service worker mới */
  if('serviceWorker' in navigator){
    navigator.serviceWorker.addEventListener('controllerchange',function(){location.reload();});
    var sv='/sw.js';
    navigator.serviceWorker.register(sv).then(function(reg){
      reg.addEventListener('updatefound',function(){
        var nw=reg.installing;
        if(!nw) return;
        nw.addEventListener('statechange',function(){
          if(nw.state==='installed' && navigator.serviceWorker.controller){
            var note=document.createElement('button');
            note.type='button';note.id='note-ref';
            note.textContent=(document.documentElement.getAttribute('lang')==='fr')?
              '⟳ Nouvelle version — actualiser ?':'⟳ '+(document.documentElement.getAttribute('lang')==='en'?
              'New version available — refresh?':'⟳ Đã có bản cập nhật — làm mới?');
            note.style.cssText='position:fixed;bottom:16px;left:50%;transform:translateX(-50%);z-index:99;'+
              'border:1px solid var(--accent,#b25d7d);border-radius:999px;background:#fff;color:#000;'+
              'font:700 .8rem system-ui;padding:8px 18px;cursor:pointer;box-shadow:0 6px 18px rgba(0,0,0,.15)';
            note.addEventListener('click',function(){note.remove();doReload();});
            document.body.appendChild(note);
            setTimeout(function(){if(note.parentNode)note.remove();},30000);
          }
        });
      });
    }).catch(function(){});
  }
})();

  var REF_L={vi:'Làm mới',en:'Refresh',fr:'Rafraîchir'};
  function updRefLabel(){var t=document.getElementById('nut-ref-t');if(t){var lg=(document.documentElement.getAttribute('lang')||'vi').slice(0,2);t.textContent=REF_L[lg]||REF_L.vi;}}
  setInterval(updRefLabel,600);
  try{new MutationObserver(updRefLabel).observe(document.documentElement,{attributes:true,attributeFilter:['lang']});}catch(e){}
  updRefLabel();
</script>

<script>
/* DeepMind header: thu gọn khi cuộn + reveal-on-scroll + parallax nhẹ hero */
(function(){
  var nav=document.getElementById('dmnav');
  function onScroll(){
    if(nav){nav.classList.toggle('shrink',window.scrollY>24);}
    var b=document.getElementById('bando');
    if(b){b.style.transform='translateY('+Math.min(40,Math.max(0,window.scrollY*0.06))+'px) scale(1.02)';}
    var rs=document.querySelectorAll('.reveal:not(.on)');
    var vh=window.innerHeight;
    rs.forEach(function(el){if(el.getBoundingClientRect().top<vh*0.88){el.classList.add('on');}});
  }
  window.addEventListener('scroll',onScroll,{passive:true});
  document.querySelectorAll('.reveal').forEach(function(el){onScroll();});
  var y=document.getElementById('dm-year');
  if(y){y.textContent=new Date().getFullYear()+' · '+(document.documentElement.getAttribute('lang')==='en'?'Je m\'appelle Hương website':'Website Je m\'appelle Hương');}
})();
</script>

<script>
/* UI sound: tiếng "ting" mềm khi hover menu/nút + "blip" khi chuyển trang (Web Audio, không file) */
(function(){
  try{
    if(matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var _ac=null;
    function _g(){
      if(!_ac){
        try{_ac=new (window.AudioContext||window.webkitAudioContext)();}catch(e){return null;}
      }
      if(_ac.state==='suspended'){_ac.resume();}
      return _ac;
    }
    function _tone(freq,dur,vol,type,slide){
      var ac=_g();if(!ac)return;
      try{
        var o=ac.createOscillator(),gn=ac.createGain();
        o.type=type||'sine';
        o.frequency.setValueAtTime(freq,ac.currentTime);
        if(slide){o.frequency.exponentialRampToValueAtTime(slide,ac.currentTime+dur*0.9);}
        gn.gain.setValueAtTime(vol||0.05,ac.currentTime);
        gn.gain.exponentialRampToValueAtTime(0.0001,ac.currentTime+dur);
        o.connect(gn).connect(ac.destination);
        o.start();o.stop(ac.currentTime+dur+0.02);
      }catch(e){}
    }
    var last=0;
    function hoverSnd(){
      var now=performance.now();
      if(now-last<120)return; // debounce 120ms
      last=now;
      _tone(1200+Math.random()*300,0.07,0.028,'sine');
    }
    document.querySelectorAll('nav a, .sitenav a, .dmnav a, .fnav a, button, [role=button], .tram, .bc-item').forEach(function(el){
      el.addEventListener('mouseenter',hoverSnd,{passive:true});
    });
    // click chuyển trang: "whoosh" nhẹ
    document.addEventListener('click',function(e){
      var a=e.target.closest('a[href]');
      if(a && a.getAttribute('href') && !a.getAttribute('href').startsWith('#') && !a.getAttribute('href').startsWith('javascript')){
        try{
          var ac=_g();
          if(!ac)return;
          var o=ac.createOscillator(),gn=ac.createGain();
          o.type='triangle';
          o.frequency.setValueAtTime(900,ac.currentTime);
          o.frequency.exponentialRampToValueAtTime(340,ac.currentTime+0.18);
          gn.gain.setValueAtTime(0.05,ac.currentTime);
          gn.gain.exponentialRampToValueAtTime(0.0001,ac.currentTime+0.2);
          o.connect(gn).connect(ac.destination);
          o.start();o.stop(ac.currentTime+0.22);
        }catch(err){}
      }
    },true);
  }catch(e){}
})();
</script>
</body>
</html>
