<!doctype html><html lang="vi"><head><meta charset="utf-8"><title>B · Keynote — Bìa</title><style>
*{margin:0;box-sizing:border-box}
body{width:1920px;height:1080px;background:#0a0a0c;color:#f5f5f7;font-family:-apple-system,"SF Pro Display","Segoe UI",Roboto,sans-serif;overflow:hidden;display:flex;flex-direction:column;align-items:center}
.kicker{margin-top:92px;font-size:24px;font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:#9b9ba1}
h1{margin-top:18px;font-size:150px;font-weight:800;letter-spacing:-.03em;text-align:center;line-height:1;background:linear-gradient(115deg,#f5f5f7 30%,#e8b7c2 55%,#cdd6ea 80%);-webkit-background-clip:text;background-clip:text;color:transparent}
.sub{margin-top:26px;font-size:34px;color:#c8c8cd;font-weight:500}
.sub b{color:#f5f5f7}
.stage{margin-top:64px;position:relative}
.stage img{display:block;width:1150px;border-radius:28px;box-shadow:0 40px 120px rgba(0,0,0,.65)}
.stage::after{content:"";position:absolute;left:5%;right:5%;bottom:-38px;height:38px;background:radial-gradient(ellipse at 50% 0,rgba(232,183,194,.28),transparent 70%)}
</style></head><body>
<div class="kicker">Đại học Cần Thơ · 2026</div>
<h1>Je m'appelle Hương</h1>
<p class="sub">Một hệ sinh thái học thuật số. <b>Từ luận án đến bốn phần mềm mở.</b></p>
<div class="stage"><img src="../../assets/img/garden_hub.jpg" alt="Garden Hub"></div>
</body></html>
