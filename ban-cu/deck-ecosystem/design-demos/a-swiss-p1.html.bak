<!doctype html><html lang="vi"><head><meta charset="utf-8"><title>A · Swiss — Bìa</title><style>
*{margin:0;box-sizing:border-box}
body{width:1920px;height:1080px;background:#fff;color:#111;font-family:"Helvetica Neue",Helvetica,Arial,"Inter",sans-serif;overflow:hidden}
.band{display:flex;justify-content:space-between;align-items:center;padding:34px 90px;border-bottom:2px solid #111;font-size:20px;font-weight:700;letter-spacing:.14em;text-transform:uppercase}
.band .dot{color:#c4596b}
main{padding:120px 90px 0}
h1{font-size:118px;line-height:1.04;font-weight:800;letter-spacing:-.015em;max-width:1560px}
h1 em{font-style:normal;color:#c4596b}
.rule{width:220px;height:10px;background:#c4596b;margin:64px 0 48px}
.sub{font-size:30px;line-height:1.5;color:#444;max-width:1100px}
.meta{position:absolute;left:90px;right:90px;bottom:64px;display:grid;grid-template-columns:1fr 1fr 1fr;border-top:1px solid #111;padding-top:26px;font-size:19px;color:#111}
.meta b{display:block;font-size:14px;letter-spacing:.12em;text-transform:uppercase;color:#888;margin-bottom:6px}
</style></head><body>
<div class="band"><span>Je m'appelle Hương <span class="dot">·</span> Hệ sinh thái học thuật số</span><span>2026</span></div>
<main>
  <h1>Một luận án.<br>Bốn phần mềm mở.<br>Một <em>khu vườn tri thức</em> từ Cần Thơ.</h1>
  <div class="rule"></div>
  <p class="sub">Đỗ Thùy Hương — giảng viên, nghiên cứu sinh tiến sĩ Quản trị kinh doanh, Đại học Cần Thơ. <span style="color:#888">A digital academic ecosystem from the Mekong Delta.</span></p>
</main>
<div class="meta">
  <div><b>Nghiên cứu</b>Quốc tế hóa &amp; hiệu quả doanh nghiệp · 50 nền kinh tế</div>
