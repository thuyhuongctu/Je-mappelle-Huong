<!doctype html><html lang="vi"><head><meta charset="utf-8"><title>01-cover</title><style>*{margin:0;box-sizing:border-box}
body{width:1920px;height:1080px;overflow:hidden;background:linear-gradient(180deg,#dde6f6 0,#f9f1e6 460px);font-family:system-ui,sans-serif;color:#463029}
.serif{font-family:Georgia,"Times New Roman",serif}
em{font-style:italic;color:#c4596b}
.clay{background:#fffdf8;border-radius:34px;box-shadow:inset 0 3px 0 rgba(255,255,255,.8),0 18px 46px rgba(150,95,75,.2)}
.pill{display:inline-block;font-size:19px;font-weight:800;padding:8px 18px;border-radius:999px;background:#fae3e6;color:#a8394e;box-shadow:inset 0 1.5px 0 rgba(255,255,255,.6)}
.pill.g{background:#cdeacf;color:#2e6b45}.pill.b{background:#dde6f6;color:#3d5a96}.pill.y{background:#f6e7c8;color:#8a621c}
.kick{font-size:20px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:#c4596b}
h2.title{font-family:Georgia,serif;font-size:72px;margin-top:10px}
.muted{color:#8d7166}
</style></head><body>
<div style="position:absolute;inset:0;background:url('../../assets/img/garden_hub.jpg') center/cover"></div>
<div style="position:absolute;inset:auto 0 0 0;height:52%;background:linear-gradient(180deg,transparent,rgba(249,241,230,.96) 62%)"></div>
<div class="clay" style="position:absolute;left:50%;bottom:74px;transform:translateX(-50%);width:1250px;border-radius:40px;padding:56px 70px 48px;text-align:center">
  <h1 class="serif" style="font-size:96px">Je m'appelle <em>Hương</em></h1>
  <p class="muted" style="margin-top:16px;font-size:28px">Khu vườn tri thức số từ Cần Thơ — luận án tiến sĩ &amp; bốn phần mềm mở</p>
  <div style="margin-top:30px;display:flex;gap:16px;justify-content:center">
    <span class="pill" style="font-size:22px;padding:12px 28px">🌸 Nghiên cứu</span>
    <span class="pill g" style="font-size:22px;padding:12px 28px">🎮 BizOn</span>
    <span class="pill b" style="font-size:22px;padding:12px 28px">📚 EnQuiz</span>
    <span class="pill y" style="font-size:22px;padding:12px 28px">🎵 Âm nhạc</span>
  </div>
</div></body></html>